<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Foto Produk -->
        <ImageView
            android:id="@+id/ivFotoProduk"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:contentDescription="Foto Produk"/>

        <!-- Badge Kategori -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipKategori"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Makanan"
            android:textSize="10sp"
            android:backgroundTint="#FFE0B2"
            android:textColor="#FF6F00"
            style="@style/Widget.MaterialComponents.Chip.Entry"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- Nama Produk -->
            <TextView
                android:id="@+id/tvNamaProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Produk"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="2dp"/>

            <!-- Deskripsi -->
            <TextView
                android:id="@+id/tvDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi produk..."
                android:textSize="11sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="6dp"/>

            <!-- Harga dibuat sendiri biar tidak bentrok tombol -->
            <TextView
                android:id="@+id/tvHarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp 110.450"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginBottom="6dp"/>

            <!-- Stok + Tombol -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Stok -->
                <TextView
                    android:id="@+id/tvStok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stok: 10"
                    android:textSize="10sp"
                    android:textColor="#9E9E9E"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <!-- Tombol Tambah Cart -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTambahCart"
                    android:layout_width="86dp"
                    android:layout_height="32dp"
                    android:text="+ Keranjang"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#FF6F00"
                    style="@style/Widget.MaterialComponents.Button"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>